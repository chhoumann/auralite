{
  "name": "auralite",
  "version": "1.4.0",
  "author": "Christian Bager Bach Houmann",
  "repository": {
    "type": "git",
    "url": "https://github.com/chhoumann/auralite.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "main": "main.js",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.4",
    "esbuild-plugin-copy": "^2.1.1",
    "git-contributors": "^0.2.5",
    "obsidian": "^1.8.7",
    "semantic-release": "^24.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.5.3"
  },
  "description": "",
  "license": "MIT",
  "scripts": {
    "dev": "bun ./esbuild.config.mjs",
    "build": "bun ./esbuild.config.mjs production",
    "lint": "biome lint src version-bump.ts",
    "format": "biome format src version-bump.ts --write",
    "check": "biome check --write src version-bump.ts && bun run type-check",
    "type-check": "bun tsc --noEmit",
    "version": "bun ./version-bump.ts && git add manifest.json versions.json",
    "semantic-release": "semantic-release"
  },
  "type": "commonjs",
  "dependencies": {
    "@codemirror/basic-setup": "^0.20.0",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/merge": "^6.10.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.8",
    "@instructor-ai/instructor": "^1.7.0",
    "openai": "^4.100.0",
    "three-way-merge": "^0.1.0",
    "zod": "^3.24.4"
  }
}
