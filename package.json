{
  "name": "auralite",
  "version": "1.6.1",
  "author": "Christian Bager Bach Houmann",
  "repository": {
    "type": "git",
    "url": "https://github.com/chhoumann/auralite.git"
  },
  "main": "main.js",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "1.4.3",
    "esbuild": "^0.25.4",
    "obsidian": "1.14.4",
    "semantic-release": "^24.2.4",
    "typescript": "7.0.2"
  },
  "description": "",
  "license": "MIT",
  "scripts": {
    "dev": "bun ./esbuild.config.mjs",
    "build": "bun ./esbuild.config.mjs production",
    "test": "bun test",
    "lint": "biome lint src version-bump.ts",
    "format": "biome format src version-bump.ts --write",
    "check": "biome check --write src version-bump.ts && bun run type-check",
    "type-check": "tsc --noEmit",
    "version": "bun ./version-bump.ts && bun run build && git add manifest.json versions.json",
    "semantic-release": "semantic-release"
  },
  "type": "commonjs",
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@instructor-ai/instructor": "^1.7.0",
    "codemirror": "6.0.2",
    "openai": "^4.100.0",
    "three-way-merge": "^0.1.0",
    "zod": "^3.24.4"
  }
}
