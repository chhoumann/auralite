  "repository": {
    "type": "git",
    "url": "https://github.com/chhoumann/auralite.git"
  },
  "main": "main.js",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@semantic-release/git": "11.0.1",
    "@types/bun": "1.4.3",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2"
  },
  "description": "",
  "license": "MIT",
  "scripts": {
    "dev": "bun ./esbuild.config.mjs",
    "build": "bun ./esbuild.config.mjs production",
    "test": "bun test",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "check": "biome check --write . && bun run type-check",
    "type-check": "tsc --noEmit",
    "version": "bun ./version-bump.ts && bun run build && git add manifest.json versions.json",
    "semantic-release": "semantic-release"
  },
  "type": "commonjs",
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
